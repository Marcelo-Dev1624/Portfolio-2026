# SPA fallback — let React Router handle client-side routes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # If the request matches an actual file or directory, serve it as-is.
  # This keeps /api/send.php, /assets/*.js, images, etc. working.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise, hand the request to index.html so React Router can route it.
  RewriteRule . /index.html [L]
</IfModule>

# Defense in depth — block direct browser access to config.php
# (PHP would just execute it and return nothing, but this is explicit.)
<FilesMatch "^config\.php$">
  Require all denied
</FilesMatch>
